# ==============================================================================
# Server & Environment Configuration
# ==============================================================================
APP_NAME="AI-Startup-Idea-Validator"
ENVIRONMENT="development" # development | staging | production
DEBUG=True
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"

# ==============================================================================
# CORS Configuration (Comma-separated list of allowed origins)
# ==============================================================================
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://your-vercel-domain.vercel.app"

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/startup_validator_db"

# ==============================================================================
# AI & External Search Services (Future Milestones)
# ==============================================================================
# LLM Provider Key (OpenAI / Anthropic / Google Gemini)
OPENAI_API_KEY="your-openai-api-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"

# Tavily Real-Time Web Search API Key
TAVILY_API_KEY="tvly-your-tavily-api-key-here"

# ==============================================================================
# Logging Configuration
# ==============================================================================
LOG_LEVEL="INFO"
