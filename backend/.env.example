# ==============================================================================
# AI Startup Idea Validator - Environment Configuration
# Infosys Springboard Virtual Internship 7.0 - Milestone 1
# ==============================================================================

# Application Metadata & Server Configuration
APP_NAME="AI-Startup-Idea-Validator"
ENVIRONMENT="development"
PORT=8000
API_PREFIX="/api/v1"

# LLM Provider API Keys (Priority 1: Gemini, Priority 2: OpenAI, Priority 3: Groq)
GEMINI_API_KEY="your-gemini-api-key-here"
OPENAI_API_KEY="your-openai-api-key-here"
GROQ_API_KEY="your-groq-api-key-here"
DEFAULT_LLM_PROVIDER="auto" # 'auto' | 'gemini' | 'openai' | 'groq'

# Tavily Real-Time Web Search API Key
TAVILY_API_KEY="tvly-your-tavily-api-key-here"

# Frontend URL for Cross-Origin Resource Sharing (CORS)
FRONTEND_URL="http://localhost:5173"

# Application Logging Level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL="INFO"
