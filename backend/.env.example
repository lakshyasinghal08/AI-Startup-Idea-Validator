# ==============================================================================
# AI Startup Idea Validator - Environment Configuration Template
# Infosys Springboard Virtual Internship 7.0 - Milestone 1
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' inside the 'backend/' folder:
#       cp .env.example .env
# 2. Add your genuine Groq API key and Tavily API key below.
# 3. DO NOT commit your real '.env' file containing API keys to GitHub.
# ==============================================================================

# Application Metadata & Server Configuration
APP_NAME="AI-Startup-Idea-Validator"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000
API_PREFIX="/api/v1"

# ------------------------------------------------------------------------------
# 1. AI LLM Provider Configuration (Groq / Gemini / OpenAI)
# ------------------------------------------------------------------------------
# Active LLM provider choice: 'groq' | 'gemini' | 'openai' | 'auto'
# Recommended: 'groq' (High-speed inference with free tier access to Llama 3.3 70B)
DEFAULT_LLM_PROVIDER="groq"

# Groq Cloud API Key
# Sign up free: https://console.groq.com/keys
# Key format: starts with 'gsk_'
GROQ_API_KEY="your-groq-api-key-here"

# (Optional) Google Gemini API Key
# Sign up free: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# (Optional) OpenAI API Key
# Sign up: https://platform.openai.com/api-keys
OPENAI_API_KEY="your-openai-api-key-here"

# ------------------------------------------------------------------------------
# 2. Real-Time Web Search & Market Intelligence (Tavily AI Search)
# ------------------------------------------------------------------------------
# Tavily API Key for live competitor discovery and market trends
# Sign up free (1,000 free searches/month): https://tavily.com
# Key format: starts with 'tvly-'
TAVILY_API_KEY="tvly-your-tavily-api-key-here"

# ------------------------------------------------------------------------------
# 3. Frontend & Security Configuration
# ------------------------------------------------------------------------------
# Allowed CORS Origin for frontend application
FRONTEND_URL="http://localhost:5173"

# Application Logging Level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL="INFO"
